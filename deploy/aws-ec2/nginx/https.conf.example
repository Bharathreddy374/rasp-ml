# Optional: HTTPS on this box with a certificate you already have (no certbot).
#
# 1. Put the files on the instance:   deploy/aws-ec2/certs/fullchain.pem, privkey.pem
# 2. Copy this file to nginx/https.conf and mount it plus the certs in docker-compose.yml:
#        ports:   - "443:443"
#        volumes: - ./nginx/https.conf:/etc/nginx/conf.d/https.conf:ro
#                 - ./certs:/etc/nginx/certs:ro
# 3. Open port 443 in the security group, then: docker compose up -d
#
# Simpler alternatives: Cloudflare proxied DNS (Cloudflare's certificate, "Full" mode with a
# Cloudflare origin certificate here), or an AWS ALB with a free ACM certificate.

server {
    listen 443 ssl;
    http2 on;
    server_name collector.example.com;          # your domain
    server_tokens off;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 300k;

    location / {
        limit_req zone=per_ip burst=20 nodelay;
        proxy_pass http://collector;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
