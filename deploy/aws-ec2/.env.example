# Copy to .env (git-ignored) on the EC2 instance. setup-ec2.sh fills the generated values.

# Neon (or RDS) PostgreSQL. Required.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Admin endpoints (/v1/sessions, /v1/model). Generated by setup-ec2.sh.
ADMIN_TOKEN=

# HMAC key for /v1/challenge nonces. REQUIRED with more than one worker, and must not change:
# every worker and every restart must accept the others' nonces. Generated by setup-ec2.sh.
CHALLENGE_SECRET=

# uvicorn worker processes (about 1 per vCPU; each loads the model, ~100 MB RAM)
WEB_CONCURRENCY=2

# enforce = final level is max(rules, ML); shadow = ML is only recorded
ML_MODE=enforce

# Optional
COLLECT_API_KEY=
EDGE_SECRET=
DB_SCHEMA=public
MAX_BODY_KB=256
